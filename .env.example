APP_ENV=development
APP_NAME=ReqFlow AI
LOG_LEVEL=INFO
JWT_SECRET=replace-with-a-long-random-development-secret

POSTGRES_DB=reqflow
POSTGRES_USER=reqflow
POSTGRES_PASSWORD=reqflow_dev_only_change_me
DATABASE_URL=postgresql+psycopg://reqflow:reqflow_dev_only_change_me@postgres:5432/reqflow
REDIS_URL=redis://redis:6379/0

EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_MODEL=qwen2.5:3b

# Not required for Phase 1 health checks
OPENAI_API_KEY=
OPENAI_MODEL=
EMBEDDING_MODEL=

# Later integrations
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPOSITORY=

VITE_API_BASE_URL=http://localhost:8000
