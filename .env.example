APP_ENV=development
APP_NAME=ReqFlow AI
LOG_LEVEL=INFO
JWT_SECRET=replace-with-a-long-random-development-secret

POSTGRES_DB=reqflow
POSTGRES_USER=reqflow
POSTGRES_PASSWORD=reqflow_dev_only_change_me
DATABASE_URL=postgresql+psycopg://reqflow:reqflow_dev_only_change_me@postgres:5432/reqflow
REDIS_URL=redis://redis:6379/0

EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_MODEL=qwen2.5:3b

# Phase 1-3 use local Ollama inference and embeddings; no API key is required.
# Later integrations
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPOSITORY=

VITE_API_BASE_URL=http://localhost:8000

# Phase 5 disabled by default. Keep local only; the application has no user authentication yet.
PHASE5_ENABLE_LIVE_PUBLISH=false
PHASE5_PUBLISH_KEY=
JIRA_ISSUE_TYPE=Task
JIRA_ISSUE_TYPE_ID=10011
JIRA_REPORTER_ACCOUNT_ID=

# Phase 6: direct MCP runs without a signed-in user; OFF by default.
PHASE6_ENABLE_TRUSTED_MCP=false
PHASE6_TRUSTED_MCP_LIVE=false
